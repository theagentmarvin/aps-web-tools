# Coordinador BIM (SalfaCorp) — environment variables
# Copy to .env.local and fill in your values. NEVER commit .env.local (it is git-ignored).
# The server reads .env.local itself; secrets never reach the browser or .mcp.json.
# Usage is governed by SalfaCorp's "Procedimiento Acceso Herramientas IA".

# ── APS app (https://aps.autodesk.com/myapps) — required for live ACC ─────────
# Client id (APS_CLIENT_ID is accepted as an alias).
VITE_APS_CLIENT_ID=your_client_id_here
# Server-only: NO VITE_ prefix, never reaches the browser.
APS_CLIENT_SECRET=your_client_secret_here
# Browser login callback (register it in the APS app). The CLI also needs
# http://localhost:8765/callback registered (see APS_CALLBACK_PORT).
VITE_APS_CALLBACK_URL=http://localhost:3000/auth/callback

# ── Web UI ────────────────────────────────────────────────────────────────────
# "http" = the UI talks to the real coordinator API (/api/coord); "mock" = in-memory demo data.
VITE_COORD_API=http

# ── Optional ──────────────────────────────────────────────────────────────────
# Loopback port for the CLI/MCP PKCE login (default 8765).
# APS_CALLBACK_PORT=8765
# Scopes of the browser (viewer) token, downscoped on refresh (default "data:read viewables:read").
# APS_BROWSER_SCOPE=data:read viewables:read
# Port of the standalone API (npm run api; default 3001).
# COORD_API_PORT=3001

# ── Runtime switches (usually set per command, not here) — see docs/api.md ───
# COORD_DATA_SOURCE=fixtures        # offline mode over tests/fixtures (npm run demo sets it)
# COORDINATOR_HOME=.coordinator     # store directory (tests/demo use their own)
# COORDINATOR_CONFIG=coordinator.config.json
# COORD_SECURE_DIR=                 # secrets dir (default %APPDATA%\bim-coordinator or ~/.config/bim-coordinator)
# COORD_KEY_PROTECTION=none         # disable DPAPI key protection (tests only)
# COORD_FIXTURE_DIR=tests/fixtures  # fixture data for COORD_DATA_SOURCE=fixtures
