{
  "name": "bim-coordinator-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-repo.mjs",
    "mcp": "tsx server/mcp/index.ts",
    "api": "tsx server/api/standalone.ts",
    "coordinator": "tsx server/cli.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-virtual": "3.14.22",
    "chart.js": "^4.5.1",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.0",
    "react-router": "^8.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  }
}
