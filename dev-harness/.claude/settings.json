{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["coord"],
  "permissions": {
    "deny": [
      "mcp__coord__apply_approved_proposals",
      "Read(~/AppData/Local/bim-coordinator/data/**)",
      "Read(~/AppData/Local/bim-coordinator/backups/**)",
      "Read(~/AppData/Roaming/bim-coordinator/**)",
      "Read(~/.local/share/bim-coordinator/data/**)",
      "Read(~/.local/share/bim-coordinator/backups/**)",
      "Read(~/.config/bim-coordinator/**)",
      "Edit(~/AppData/Local/bim-coordinator/data/**)",
      "Edit(~/AppData/Local/bim-coordinator/backups/**)",
      "Edit(~/AppData/Roaming/bim-coordinator/**)",
      "Edit(~/.local/share/bim-coordinator/data/**)",
      "Edit(~/.local/share/bim-coordinator/backups/**)",
      "Edit(~/.config/bim-coordinator/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.mjs"], "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__coord__.*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-mcp.mjs"], "timeout": 10 }
        ]
      }
    ]
  }
}
