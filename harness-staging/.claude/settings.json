{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["coord"],
  "permissions": {
    "allow": [
      "mcp__coord__get_*",
      "mcp__coord__list_*",
      "mcp__coord__set_active_context",
      "mcp__coord__ingest_clash_test",
      "mcp__coord__summarize_clashes",
      "mcp__coord__run_classification",
      "mcp__coord__diff_test_versions",
      "mcp__coord__propose_*",
      "mcp__coord__draft_issue",
      "mcp__coord__withdraw_proposal",
      "mcp__coord__record_feedback",
      "mcp__coord__evaluate_ruleset",
      "mcp__coord__generate_report",
      "Edit(./.coordinator/projects/*/notes.md)"
    ],
    "ask": [
      "mcp__coord__apply_approved_proposals",
      "Edit(./rules/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.coordinator/auth/**)",
      "Read(./.coordinator/secret/**)",
      "Read(~/AppData/Roaming/bim-coordinator/**)",
      "Read(~/.config/bim-coordinator/**)",
      "Edit(~/AppData/Roaming/bim-coordinator/**)",
      "Edit(~/.config/bim-coordinator/**)",
      "Edit(~/.claude/**)",
      "Edit(./.git/**)",
      "Edit(./.coordinator/auth/**)",
      "Edit(./.coordinator/secret/**)",
      "Edit(./.coordinator/approvals/**)",
      "Edit(./.coordinator/batches/**)",
      "Edit(./.coordinator/proposals/**)",
      "Edit(./.coordinator/store/**)",
      "Edit(./.coordinator/state/**)",
      "Edit(./.coordinator/applied/**)",
      "Edit(./.coordinator/decisions/**)",
      "Edit(./.coordinator/audit/**)",
      "Edit(./.coordinator/feedback/**)",
      "Edit(./.coordinator/cache/**)",
      "WebFetch(domain:developer.api.autodesk.com)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__coord__apply_approved_proposals",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-apply.mjs"], "timeout": 60 }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.mjs"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"], "timeout": 10 }
        ]
      },
      {
        "matcher": "^mcp__(?!coord__)",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-foreign-mcp.mjs"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__coord__.*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/audit-log.mjs"], "async": true, "timeout": 10 }
        ]
      }
    ]
  }
}
